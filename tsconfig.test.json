{
    // Dual typecheck gate (run by `npm run typecheck`): compiles src/ AND the
    // tests so latent test-only type errors are enforced by CI, not just by
    // vitest's transpile-only run.
    //
    // `exclude` is OVERRIDDEN here on purpose: it is inherited from
    // ./tsconfig.json, whose exclude list drops "tests" — without this
    // override the `include` below would match nothing and the gate would
    // silently typecheck zero test files.
    //
    // The three env-gated live suites (*.live.test.ts) are RUNTIME-gated
    // (CANARY=1 / FINGERPRINT_LIVE=1 / INTEGRATION_LIVE=1 control whether
    // their tests execute against the network) — typechecking them is free
    // and catches drift even on machines that never run them live.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "rootDir": "."
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
